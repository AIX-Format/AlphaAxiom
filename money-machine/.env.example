# =============================================================
# AlphaAxiom / Money Machine - Environment Variables
# =============================================================
# The Python sidecar and Rust shell read these from the real process
# environment (os.environ). There is no dotenv loader, so a plain
# .env.local file will NOT be picked up automatically.
#
# To use these values, export them in your shell before launching
# (`export GEMINI_API_KEY=...`) or set them in your process manager
# (launchd plist, systemd unit, npm script env block, etc.). On
# macOS/Windows the Tauri shell can also seed secrets from the OS
# keychain at boot.
#
# Never commit a populated copy of this file.
# Only the variables listed here are actually read by the code today.
# Anything marked "Reserved" is on the roadmap and is documented so
# that follow-up PRs can wire it up without breaking existing users.
# =============================================================

# -------------------------------------------------------------
# AI Brain (Google Gemini)
# Read by: signal_generator.py, skill_executor.py, utils/config.py
# -------------------------------------------------------------
GEMINI_API_KEY=
# Optional alias. utils/config.py falls back to GOOGLE_API_KEY if
# GEMINI_API_KEY is unset.
GOOGLE_API_KEY=
# Override the Gemini model. Defaults to gemini-1.5-flash.
GEMINI_MODEL=gemini-1.5-flash

# -------------------------------------------------------------
# Exchange (CCXT, single venue)
# Read by: utils/config.py -> engine/trading_core.py
# -------------------------------------------------------------
# Any CCXT-supported exchange id, e.g. binance, bybit, okx.
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
# Set to "false" to hit live trading. Defaults to "true" (sandbox).
EXCHANGE_SANDBOX=true

# -------------------------------------------------------------
# Trading runtime
# Read by: utils/config.py
# -------------------------------------------------------------
# Starting balance used by the in-memory portfolio when no exchange
# is connected, or before the first balance sync.
INITIAL_BALANCE=10000
# Per-trade risk cap as a fraction of equity (0.02 = 2%).
MAX_RISK_PER_TRADE=0.02
# Daily loss cap as a fraction of equity (0.05 = 5%).
MAX_DAILY_LOSS=0.05

# -------------------------------------------------------------
# IPC (Rust shell <-> Python sidecar)
# Read by: main.py, utils/ipc_server.py, utils/ipc_auth.py
# -------------------------------------------------------------
# Port the Python IPC server listens on. The Rust shell sets this
# when it spawns the sidecar.
TAURI_PORT=19284
# Shared secret used to authenticate every IPC request. The Tauri
# Rust shell generates this at first launch and stores it in the OS
# keychain (service "money-machine", account "ipc-auth-token"); the
# Python sidecar reads it back from the keychain when this env var
# is unset. Override here for tests or for running the sidecar
# stand-alone without the Rust shell.
IPC_AUTH_TOKEN=

# -------------------------------------------------------------
# Reserved (roadmap, NOT read by the code today)
# -------------------------------------------------------------
# MT5 bridge via Cloudflare Worker. Reserved for the MT5 adapter PR.
# MT5_ORACLE_URL=https://oracle.axiomid.app
# MT5_SIGNING_KEY=

# Blockchain adapters. Reserved for the on-chain execution PR.
# EVM_RPC_ETHEREUM=
# EVM_RPC_ARBITRUM=
# EVM_RPC_BASE=
# SOLANA_RPC=https://api.mainnet-beta.solana.com
# WALLET_KEYSTORE_PATH=
