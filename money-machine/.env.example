# =============================================================
# AlphaAxiom / Money Machine - Environment Variables
# Copy this file to .env.local and fill in your own values.
# Never commit a real .env file to git.
# =============================================================

# -------------------------------------------------------------
# AI Brains
# -------------------------------------------------------------
# Google Gemini (cloud signal generation)
GEMINI_API_KEY=
# Override the Gemini model. Defaults to gemini-1.5-flash.
GEMINI_MODEL=gemini-1.5-flash

# -------------------------------------------------------------
# Exchange APIs (centralized exchanges)
# -------------------------------------------------------------
# Bybit V5
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Set to true to hit the Bybit testnet.
BYBIT_SANDBOX=true

# Binance (used by default for CCXT mock/data)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SANDBOX=true

# -------------------------------------------------------------
# MT5 Bridge (Cloudflare Worker relay)
# -------------------------------------------------------------
MT5_ORACLE_URL=https://oracle.axiomid.app
# Ed25519 private key (base64) used to sign MT5 signals.
# In production this lives in the OS keychain; the env var is for dev only.
MT5_SIGNING_KEY=

# -------------------------------------------------------------
# Blockchain (EVM + Solana) - reserved for Phase 3
# -------------------------------------------------------------
# Comma-separated RPC URLs per chain.
EVM_RPC_ETHEREUM=
EVM_RPC_ARBITRUM=
EVM_RPC_BASE=
SOLANA_RPC=https://api.mainnet-beta.solana.com
# Path to an encrypted keystore. The password lives in the OS keychain.
WALLET_KEYSTORE_PATH=

# -------------------------------------------------------------
# IPC (Rust <-> Python sidecar)
# -------------------------------------------------------------
# Port the Python IPC server listens on. The Rust shell writes this
# value when it spawns the sidecar.
TAURI_PORT=19284
# Shared secret used to authenticate IPC requests. Generated by the
# Rust shell at boot and passed through env. Do not set manually.
TAURI_IPC_TOKEN=

# -------------------------------------------------------------
# Trading runtime
# -------------------------------------------------------------
# Starting balance used by the in-memory portfolio when no exchange
# is connected.
INITIAL_BALANCE=10000
